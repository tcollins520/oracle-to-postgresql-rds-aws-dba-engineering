# PURPOSE: Prevent local Terraform state, plans, credentials, private keys, and editor files from entering source control.
# SECURITY: Never remove the state/secret/key exclusions to make a local workflow easier.
# Terraform working directories, state and plans
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log

# Local Terraform variable/backend files
*.tfvars
!*.tfvars.example
backend.hcl

# Secrets and key material
*.pem
*.ppk
*.key
id_rsa*
id_ed25519*
*.p12
*.pfx
*.jks
*.secret.json
.env

# Tool/editor files
.terraformrc
terraform.rc
.vscode/
.idea/
.DS_Store
Thumbs.db
