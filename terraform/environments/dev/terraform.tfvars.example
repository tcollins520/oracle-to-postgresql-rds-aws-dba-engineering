# Example environment inputs for the Oracle 19c to Amazon RDS for PostgreSQL migration.
# Copy to terraform.tfvars and replace every placeholder with reviewed, environment-specific values.
# Do not put passwords, private keys, or secret JSON in this file.
project_name = "oracle-postgresql-migration"
# Environment label used in names and tags (for example, dev).
environment  = "dev"
# AWS Region in which this resource or provider operates.
aws_region   = "us-east-1"

# Reconfirm CIDRs do not overlap the Oracle RDS project, any existing AWS VPCs,
# your on-premises LAN, or networks connected to this VPC.
vpc_cidr = "10.60.0.0/16"
# CIDR ranges for public subnets that host the internet-facing tunnel gateway and optional NAT gateways.
public_subnet_cidrs = {
# Configures the `az_a` setting for this block; verify its value against the module inputs and intended AWS architecture.
  az_a = "10.60.1.0/24"
# Configures the `az_b` setting for this block; verify its value against the module inputs and intended AWS architecture.
  az_b = "10.60.2.0/24"
}
# CIDR ranges for private subnets used by RDS and DMS; these subnets do not receive public IP addresses.
private_subnet_cidrs = {
# Configures the `az_a` setting for this block; verify its value against the module inputs and intended AWS architecture.
  az_a = "10.60.11.0/24"
# Configures the `az_b` setting for this block; verify its value against the module inputs and intended AWS architecture.
  az_b = "10.60.12.0/24"
}

# No NAT Gateway is required for the base architecture: S3 uses a gateway
# endpoint and DMS endpoint credentials use a Secrets Manager interface endpoint.
# Enable NAT only if a later workload needs general public internet egress.
enable_nat_gateway = false
# When NAT is enabled, selects one shared NAT gateway rather than one per AZ. This is a cost/availability tradeoff.
single_nat_gateway = true

# IMPORTANT: Replace with the current Oracle VM public egress IP /32 before planning.
# Confirm the current public egress IP before planning; previously observed addresses may change.
oracle_source_cidr = "REPLACE_WITH_CURRENT_PUBLIC_EGRESS_IP/32"

# Paste the OpenSSH PUBLIC key line only. Keep the matching private key on the RHEL VM.
tunnel_public_key = "ssh-ed25519 REPLACE_WITH_PUBLIC_KEY_MATERIAL oracle-dms-tunnel"
# Stable private address assigned to the EC2 gateway network interface and used as the reverse-tunnel bind address.
tunnel_gateway_private_ip = "10.60.1.10"
# Private TCP port on the gateway where the reverse SSH tunnel listener is bound for DMS to reach the Oracle listener.
tunnel_listen_port        = 11521
# EC2 instance type for the lightweight SSH tunnel gateway.
tunnel_instance_type      = "t3.micro"

# RDS PostgreSQL engine version selected for the target environment.
postgres_engine_version          = "18.6"
# RDS PostgreSQL compute class selected for the target environment.
postgres_instance_class          = "db.t3.medium"
# PostgreSQL database to be inspected or loaded by the migration workflow.
postgres_database_name           = "oracle_migration"
# Master login name configured for the RDS instance; its secret is RDS-managed.
postgres_master_username         = "migration_admin"
# Initial RDS PostgreSQL storage allocation in GiB.
postgres_allocated_storage       = 30
# Maximum permitted RDS storage autoscaling size in GiB.
postgres_max_allocated_storage   = 100
# Controls RDS Multi-AZ high availability for the target database.
postgres_multi_az                = true
# Automated backup retention period for RDS point-in-time recovery.
postgres_backup_retention_days   = 7
# Keeps deletion protection enabled unless an explicitly reviewed change disables it.
postgres_deletion_protection     = true

# DMS replication instance compute class.
dms_replication_instance_class = "dms.t3.medium"
# Controls Multi-AZ deployment for the DMS replication instance.
dms_multi_az                   = false
# Storage allocated to the DMS replication instance in GiB.
dms_allocated_storage          = 50

# Set false only if these account-global roles already exist and have the required policies.
manage_dms_vpc_role = true
# Configures the `manage_dms_cloudwatch_logs_role` setting for this block; verify its value against the module inputs and intended AWS architecture.
manage_dms_cloudwatch_logs_role = true

# Keep these false during the first infrastructure deployment.
# Enable endpoints only after the source secret is populated and the tunnel tests pass.
# Enable the task only after schema conversion and target DDL have been reviewed/applied.
create_dms_endpoints             = false
# Configures the `create_dms_task` setting for this block; verify its value against the module inputs and intended AWS architecture.
create_dms_task                  = false
# Feature gate for the separate DMS Schema Conversion project; enable only after validating service support and metadata credentials.
enable_schema_conversion_project = false

# Oracle PDB service name used by the DMS replication endpoint through the SSH tunnel.
source_oracle_service_name  = "migpdb"
# Oracle database/PDB identifier supplied to Schema Conversion metadata connectivity.
source_oracle_database_name = "MIGPDB"
# Oracle source schemas included in the migration selection rules.
source_schemas              = ["COMMON", "FINANCE", "GRANTS", "PROCUREMENT"]

# Optional email address for operational alarm notifications. Leave empty to omit email subscription.
notification_email = ""
